# Copy this file to server/.env before starting the API.

# Paste your MongoDB Atlas/local connection string here.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/railpulse

# Paste the RailRadar API key here.
RAILRADAR_API_KEY=PASTE_RAILRADAR_API_KEY_HERE
RAILRADAR_BASE_URL=https://api.example.com

# Paste your OpenWeather API key here.
OPENWEATHER_API_KEY=PASTE_OPENWEATHER_API_KEY_HERE

# Paste your OpenTopography API key here.
OPENTOPOGRAPHY_API_KEY=PASTE_OPENTOPOGRAPHY_API_KEY_HERE

# Overpass normally does not require a key. Change the endpoint if needed.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
